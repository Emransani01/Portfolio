# Public site URL used for metadata, canonical links, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Server-only contact form settings (never expose RESEND_API_KEY to the client).
# Create a free API key at https://resend.com/api-keys.
RESEND_API_KEY=re_your_api_key

# Where contact messages should be delivered.
CONTACT_TO_EMAIL=emransani01@gmail.com

# Sender verified in Resend. "onboarding@resend.dev" only works for testing
# deliveries to the Resend account owner's address.
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
